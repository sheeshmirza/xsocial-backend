# ==============================================================================
# xSocial — Enterprise Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env in your root directory before starting the application:
#   cp .env.example .env
#
# IMPORTANT:
#   - NEVER commit the actual .env file with production secrets to source control.
#   - In production (NODE_ENV=production), JWT secrets MUST be at least 32 random characters.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Environment & Network Configuration
# ------------------------------------------------------------------------------
# Runtime environment: "development", "test", or "production"
NODE_ENV=development

# TCP Port on which the HTTP API and MCP JSON-RPC server listen
PORT=5000

# Global REST API route prefix (all versioned endpoints mount under this prefix)
API_PREFIX=/api/v1

# Canonical public-facing base URL of this API instance (used in OAuth redirects & MCP metadata)
PUBLIC_BASE_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. Web Client & Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Primary web frontend URL (used as default allowed origin)
CLIENT_URL=http://localhost:3000

# Comma-separated list of trusted web client origins allowed to access the API via CORS
# Example: http://localhost:3000,http://localhost:3001,https://app.xsocial.io
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# 3. MongoDB Persistence Engine (Primary Document Store)
# ------------------------------------------------------------------------------
# Connection URI for MongoDB cluster (supports standalone, replica sets, and MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/xsocial
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/xsocial

# Name of the database to use
MONGODB_DB_NAME=xsocial

# ------------------------------------------------------------------------------
# 4. Redis Cluster (Multi-Tier Caching, Token Blacklisting, & Rate Limiting)
# ------------------------------------------------------------------------------
# Connection URI for Redis instance or cluster
# Format: redis://[:password@]host:port[/db_number]
# If left empty, system automatically falls back to in-memory cache and queue
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 5. PostgreSQL (Relational 3NF Storage & ACID Transactions)
# ------------------------------------------------------------------------------
# Connection URI for PostgreSQL relational database engine
# Format: postgres://username:password@localhost:5432/xsocial?sslmode=disable
# Leave empty if running in document-only persistence mode
POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/xsocial?sslmode=disable

# ------------------------------------------------------------------------------
# 6. RabbitMQ (Enterprise AMQP 0.9.1 Asynchronous Message Broker)
# ------------------------------------------------------------------------------
# AMQP connection URL for RabbitMQ broker
# Format: amqp://username:password@localhost:5672/
# When configured, scheduled and instant post publishing routes through durable direct/topic
# exchanges (xsocial.direct) with consumer prefetch QoS and Dead Letter routing (xsocial.dlx)
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# ------------------------------------------------------------------------------
# 7. Qdrant (Vector Database Engine for AI Semantic Search)
# ------------------------------------------------------------------------------
# HTTP/REST endpoint URL for Qdrant vector database
# Format: http://localhost:6333 or https://<cluster-id>.qdrant.tech:6333
QDRANT_URL=http://127.0.0.1:6333

# Optional API key for authenticated Qdrant Cloud or protected self-hosted instances
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 8. Cryptography, JWT Secrets, & Authentication Security
# ------------------------------------------------------------------------------
# HMAC-SHA256 secret key for signing short-lived JWT Access Tokens.
# Production requirement: MUST be at least 32 characters long.
# Generate secure keys via: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_strong_random_jwt_access_secret_min_32_chars

# HMAC-SHA256 secret key for signing long-lived JWT Refresh Tokens.
# Production requirement: MUST be at least 32 characters long.
JWT_REFRESH_SECRET=replace_with_strong_random_jwt_refresh_secret_min_32_chars

# Lifespan duration for JWT access tokens (e.g., "15m", "1h")
JWT_ACCESS_EXPIRES_IN=15m

# Lifespan duration for JWT refresh tokens (e.g., "7d", "30d")
JWT_REFRESH_EXPIRES_IN=30d

# Password hashing cost factor for bcrypt (recommended: 12)
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 9. Upstream AI Wrapper Service (Multi-Modal Generation)
# ------------------------------------------------------------------------------
# Base URL of the AI content generation wrapper service (for text & image generation)
AI_WRAPPER_BASE_URL=http://localhost:3000

# Upstream request timeout in milliseconds
AI_WRAPPER_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 10. API Rate Limiting & Denial-of-Service (DoS) Shielding
# ------------------------------------------------------------------------------
# Sliding time window for rate limiting in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum permitted requests per client IP / account within the time window
RATE_LIMIT_MAX=200

# ------------------------------------------------------------------------------
# 11. Social Platform OAuth & Publishing Credentials
# ------------------------------------------------------------------------------
# Meta Graph API / Instagram Graph API
# Register application at: https://developers.facebook.com
INSTAGRAM_CLIENT_ID=your_instagram_app_id
INSTAGRAM_CLIENT_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/v1/social/callback/instagram

# LinkedIn Developer Platform
# Register application at: https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/v1/social/callback/linkedin
LINKEDIN_VERSION=202607
LINKEDIN_SCOPES=openid,profile,email,w_member_social,r_member_social,r_organization_social,w_organization_social

# ------------------------------------------------------------------------------
# 12. Model Context Protocol (MCP 2025-06-18) & OAuth 2.1 Metadata (Optional)
# ------------------------------------------------------------------------------
# OAuth 2.1 Issuer URL advertised by the MCP Authorization Server
MCP_OAUTH_ISSUER=http://localhost:5000

# Resource URI advertised in /.well-known/oauth-protected-resource
MCP_OAUTH_RESOURCE=http://localhost:5000

# Dedicated JWT signing secret for MCP Bearer tokens (defaults to JWT_ACCESS_SECRET if unset)
MCP_OAUTH_SIGNING_SECRET=

# ------------------------------------------------------------------------------
# 13. Initial Database Seeding Configuration (Optional)
# ------------------------------------------------------------------------------
# Initial password assigned to the default system administrator account (admin@xsocial.io)
SEED_ADMIN_PASSWORD=AdminPassword123!
