NODE_ENV=development
PORT=5000

API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:5000

AI_WRAPPER_BASE_URL=http://localhost:3000
AI_WRAPPER_TIMEOUT_MS=30000

MONGODB_URI=mongodb://127.0.0.1:27017/xsocial
MONGODB_DB_NAME=xsocial

JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=12

CLIENT_URL=http://localhost:3001

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

REDIS_URL=redis://127.0.0.1:6379

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/oauth/callback/linkedin
LINKEDIN_VERSION=202607

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3001/oauth/callback/instagram

SWAGGER_SERVER_URL=http://localhost:5000
