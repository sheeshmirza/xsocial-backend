# ==============================================================================
# xSocial Backend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure the values for your environment.
# NEVER commit .env to source control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:5000

# Client & CORS
CLIENT_URL=http://localhost:3000
# Comma-separated list of allowed web frontend origins (defaults to CLIENT_URL if unset)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001

# MongoDB Configuration
# For local development: mongodb://127.0.0.1:27017/xsocial
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/xsocial
MONGODB_DB_NAME=xsocial

# Redis Configuration (Job queue, distributed locks, caching, and rate limiting)
# Leave empty to fall back to in-memory queue/cache during local testing
REDIS_URL=redis://127.0.0.1:6379

# JWT & Authentication Secrets
# IMPORTANT: In production, secrets MUST be at least 32 characters long and randomly generated.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_strong_random_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_strong_random_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# AI Wrapper Service (Multi-modal generation for LinkedIn/Instagram content)
AI_WRAPPER_BASE_URL=http://localhost:3000
AI_WRAPPER_TIMEOUT_MS=30000

# API Rate Limiting (Token bucket limiter)
# RATE_LIMIT_WINDOW_MS: Window size in milliseconds (e.g. 900000 = 15 minutes)
# RATE_LIMIT_MAX: Maximum permitted requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ==============================================================================
# Social Platform OAuth & Publishing Credentials
# ==============================================================================

# Meta / Instagram Graph API
# Register your app at: https://developers.facebook.com
INSTAGRAM_CLIENT_ID=your_instagram_app_id
INSTAGRAM_CLIENT_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/v1/social/callback/instagram

# LinkedIn Developer Platform
# Register your app at: https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/v1/social/callback/linkedin
LINKEDIN_VERSION=202607
LINKEDIN_SCOPES=openid,profile,email,w_member_social,r_member_social,r_organization_social,w_organization_social

# ==============================================================================
# Model Context Protocol (MCP) & OAuth Metadata (Optional)
# ==============================================================================
# MCP_OAUTH_ISSUER=http://localhost:5000
# MCP_OAUTH_RESOURCE=http://localhost:5000
# MCP_OAUTH_SIGNING_SECRET=optional_dedicated_mcp_jwt_signing_secret

# ==============================================================================
# Database Seeder Configuration (Optional)
# Used when running: go run ./cmd/migrate seed
# ==============================================================================
SEED_ADMIN_PASSWORD=AdminPassword123!
