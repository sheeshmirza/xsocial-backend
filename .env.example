# ------------------------------------------------------------------------------
# 1. Server Environment & Network Configuration
# ------------------------------------------------------------------------------
# Runtime environment: "development", "test", or "production"
NODE_ENV=development

# TCP Port on which the HTTP API and MCP JSON-RPC server listen
PORT=5000

# Global REST API route prefix (all versioned endpoints mount under this prefix)
API_PREFIX=/api/v1

# Canonical public-facing base URL of this API instance (used in OAuth redirects & MCP metadata)
PUBLIC_BASE_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. Web Client & Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Primary web frontend URL (default allowed origin)
CLIENT_URL=http://localhost:3000

# Comma-separated list of trusted client origins allowed to access the API via CORS
CLIENT_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. MongoDB (Local Docker Container)
# ------------------------------------------------------------------------------
# Spin up local container:
#   docker run -d --name xsocial-mongo -p 27017:27017 -v xsocial_mongo:/data/db mongo:7
#
# Connection URI for local container:
MONGODB_URI=mongodb://127.0.0.1:27017/xsocial?directConnection=true

# Database name
MONGODB_DB_NAME=xsocial

# ------------------------------------------------------------------------------
# 4. Redis (Local Docker Container)
# ------------------------------------------------------------------------------
# Spin up local container:
#   docker run -d --name xsocial-redis -p 6379:6379 -v xsocial_redis:/data redis:7-alpine
#
# Connection URI for local container (caches, rate limiting, token revocation):
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 5. PostgreSQL (Local Docker Container)
# ------------------------------------------------------------------------------
# Spin up local container:
#   docker run -d --name xsocial-postgres -p 5432:5432 \
#     -e POSTGRES_USER=postgres \
#     -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=xsocial \
#     -v xsocial_pg:/var/lib/postgresql/data postgres:16-alpine
#
# Connection URI for local container (relational 3NF storage & ACID transactions):
POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/xsocial?sslmode=disable

# ------------------------------------------------------------------------------
# 6. RabbitMQ (Local Docker Container)
# ------------------------------------------------------------------------------
# Spin up local container with management dashboard:
#   docker run -d --name xsocial-rabbitmq -p 5672:5672 -p 15672:15672 rabbitmq:3-management-alpine
#
# Management Web Dashboard: http://localhost:15672 (default user/pass: guest / guest)
# AMQP connection URL for local container:
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# ------------------------------------------------------------------------------
# 7. Qdrant Vector Database (Local Docker Container)
# ------------------------------------------------------------------------------
# Spin up local container:
#   docker run -d --name xsocial-qdrant -p 6333:6333 -p 6334:6334 \
#     -v xsocial_qdrant:/qdrant/storage qdrant/qdrant:latest
#
# Web Dashboard: http://localhost:6333/dashboard
# HTTP REST endpoint URL for local container:
QDRANT_URL=http://127.0.0.1:6333

# API key (leave blank for local Docker unauthenticated instance)
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 8. Cryptography, JWT Secrets, & Authentication Security
# ------------------------------------------------------------------------------
# HMAC-SHA256 secret keys for signing JWT tokens.
# In production, these MUST be at least 32 characters long.
# Generate strong secrets via: openssl rand -hex 32
JWT_ACCESS_SECRET=d3b07384d113edec49eaa6238ad5ff00f91572d3e098485a3c89b25fcf95371c
JWT_REFRESH_SECRET=7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069

# Token lifespan
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Password hashing cost factor for bcrypt
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 9. Upstream AI Wrapper Service (Multi-Modal Generation)
# ------------------------------------------------------------------------------
# Base URL for AI text and image generation (points to local mock or AI gateway)
AI_WRAPPER_BASE_URL=http://localhost:3000
AI_WRAPPER_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 10. API Rate Limiting & DoS Shielding
# ------------------------------------------------------------------------------
# Sliding window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per client within the window
RATE_LIMIT_MAX=200

# ------------------------------------------------------------------------------
# 11. Social Platform OAuth & Publishing Credentials
# ------------------------------------------------------------------------------
# Meta Graph API / Instagram Graph API
# Register your application at: https://developers.facebook.com
INSTAGRAM_CLIENT_ID=your_instagram_app_id
INSTAGRAM_CLIENT_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/v1/social/callback/instagram

# LinkedIn Developer Platform
# Register your application at: https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/v1/social/callback/linkedin
LINKEDIN_VERSION=202607
LINKEDIN_SCOPES=openid,profile,email,w_member_social,r_member_social,r_organization_social,w_organization_social

# ------------------------------------------------------------------------------
# 12. Model Context Protocol (MCP 2025-06-18) & OAuth 2.1 Metadata (Optional)
# ------------------------------------------------------------------------------
# OAuth 2.1 Issuer advertised by MCP Authorization Server
MCP_OAUTH_ISSUER=http://localhost:5000

# Resource URI advertised in /.well-known/oauth-protected-resource
MCP_OAUTH_RESOURCE=http://localhost:5000

# Dedicated JWT signing secret for MCP Bearer tokens (defaults to JWT_ACCESS_SECRET if unset)
MCP_OAUTH_SIGNING_SECRET=

# ------------------------------------------------------------------------------
# 13. Initial Database Seeding Configuration (Optional)
# ------------------------------------------------------------------------------
# Initial password for default system administrator account (admin@xsocial.io)
SEED_ADMIN_PASSWORD=AdminPassword123!
