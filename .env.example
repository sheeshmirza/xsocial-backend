# ==============================================================================
# xSocial Backend Environment Configuration
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:5000

# Client & CORS
CLIENT_URL=http://localhost:3001
# Comma-separated allowed origins (defaults to CLIENT_URL if unset)
# CLIENT_ORIGINS=http://localhost:3001,http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/xsocial
MONGODB_DB_NAME=xsocial

# Redis Configuration (Queue, caching, rate limiting)
REDIS_URL=redis://127.0.0.1:6379

# JWT & Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# AI Wrapper Service (Gemini / Text & Image generation)
AI_WRAPPER_BASE_URL=http://localhost:3000
AI_WRAPPER_TIMEOUT_MS=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ==============================================================================
# Social Platform OAuth & Publishing Credentials
# ==============================================================================

# Instagram (Meta Graph API)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3001/oauth/callback/instagram

# LinkedIn (Developer Portal)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/oauth/callback/linkedin
LINKEDIN_VERSION=202607

# Swagger & Documentation
SWAGGER_SERVER_URL=http://localhost:5000
